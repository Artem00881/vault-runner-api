# Production configuration reference.
#
# SECRETS ARE NO LONGER STORED IN A .env FILE ON THE SERVER.
# POSTGRES_PASSWORD, JWT_SECRET and SENTRY_DSN live in the 1Password vault
# "VaultRun-Prod" and are injected at deploy time by ./op-compose.sh (op run).
# See op.prod.env for the references and DEPLOY.md §12 for the full runbook.
#
# The values below are NON-SECRET production defaults already baked into
# docker-compose.prod.yml — you normally do not need a .env file at all.

# Non-secret config (defaults live in docker-compose.prod.yml):
POSTGRES_USER=vault
POSTGRES_DB=vaultrun
CORS_ORIGIN=https://vaultrun.app
GAME_CURRENCY=DEMO
WALLET_PROVIDER_TYPE=internal
OPERATOR_WALLET_TIMEOUT_MS=3000
RESERVING_STALE_SEC=120        # periodic sweep recovers a 'reserving' bet stranded longer than this (both wallet modes)
SESSION_TOKEN_TTL_SEC=14400    # operator session ("play") token lifetime — re-launch to refresh; default 4h (audit L-C2.2)
RESERVING_ALERT_SEC=600        # a reserving/cancelling slot stranded longer than this is loud-logged (gauge + alert); default 10m (audit Low-4)

# Rate limiting (per real client IP, CF-Connecting-IP behind the edge):
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Fairness / provably-fair:
FAIRNESS_CHAIN_LENGTH=10000   # seeds per epoch (engine auto-rolls over on exhaustion)
SALT_PROVIDER_TYPE=random     # "random" (demo) | "eth-block" (grind-proof Ethereum block hash)
# Block-salt (eth-block) options:
# ETH_RPC_URLS=               # comma-separated; default publicnode,drpc,blastapi,nodies
# ETH_SALT_LEAD_BLOCKS=10     # commit this many blocks ahead of the finalized head
# ETH_RPC_TIMEOUT_MS=5000

# Secrets — managed in 1Password (vault VaultRun-Prod). Do NOT put real values
# here; they are injected from 1Password at deploy time:
#   POSTGRES_PASSWORD  ->  op://VaultRun-Prod/POSTGRES_PASSWORD/password
#   JWT_SECRET         ->  op://VaultRun-Prod/JWT_SECRET/password
#   SENTRY_DSN         ->  op://VaultRun-Prod/SENTRY_DSN/password
