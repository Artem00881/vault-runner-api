# Copy to .env on the VPS and fill in. NEVER commit the real .env.

# Postgres credentials (used by both the db container and the API connection string)
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vaultrun

# Secret used to sign guest JWTs — set to a long random string.
JWT_SECRET=CHANGE_ME_long_random_secret

# Allowed web origin(s) for CORS, comma-separated. Use your web app's URL.
# e.g. https://vault-runner.lovable.app
CORS_ORIGIN=https://your-web-app-url

GAME_CURRENCY=DEMO
