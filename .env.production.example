# Copy to .env on the VPS and fill in. NEVER commit the real .env.

# Postgres credentials (used by both the db container and the API connection string)
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vaultrun

# Secret used to sign guest JWTs — set to a long random string.
JWT_SECRET=CHANGE_ME_long_random_secret

# Allowed web origin(s) for CORS, comma-separated. Leave UNSET and the API warns
# and allows all origins — always set this in production.
CORS_ORIGIN=https://vaultrun.app

GAME_CURRENCY=DEMO

# Wallet provider: "internal" (play-money ledger, the demo) or "operator"
# (operator seamless wallet is the source of truth — requires Operator rows with
# walletApiUrl/walletApiKey seeded). Default: internal.
WALLET_PROVIDER_TYPE=internal
# Per-call timeout (ms) when talking to an operator wallet (operator mode only).
OPERATOR_WALLET_TIMEOUT_MS=3000
