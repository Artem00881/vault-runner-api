# Vault Run — HOSTED OPERATOR-MODE SANDBOX env (Phase 6 #3).
#
# Copy to `.env.sandbox` ON THE SANDBOX BOX and fill the two generated secrets.
# These are NOT real operator secrets — the sandbox runs the play-money stub wallet,
# so there is no 1Password here. Generate the secrets on the box, e.g.:
#   JWT_SECRET=$(openssl rand -hex 32)
#   STUB_WALLET_KEY=$(openssl rand -hex 16)
#
# Deploy:
#   docker compose -f docker-compose.sandbox.yml --env-file .env.sandbox up -d --build

# --- secrets (generate on the box; sandbox-only, NOT real money) ---
JWT_SECRET=                 # openssl rand -hex 32
STUB_WALLET_KEY=            # openssl rand -hex 16 — the key the API uses to call the stub
POSTGRES_PASSWORD=vault     # localhost-only on the box; fine to leave as vault

# --- stub wallet ---
STUB_START_BALANCE=100000000   # play-money starting balance per (player,currency), minor units

# --- exposure ---
# 127.0.0.1 = loopback only (verify on the box, then add a Caddy+TLS edge on a subdomain).
# Set 0.0.0.0 to expose the API on the box's public IP over plain HTTP (sandbox only).
BIND_ADDR=127.0.0.1

# --- non-secret config (safe defaults already in docker-compose.sandbox.yml) ---
GAME_CURRENCY=DEMO
CORS_ORIGIN=*
THROTTLE_LIMIT=600
# RISK_* ceilings (operator-mode boot guard) — EUR-reference examples; defaults are in the compose.
# RISK_MAX_BET=10000
# RISK_MAX_WIN_PER_BET=1000000
# RISK_MAX_MULTIPLIER=10000
# RISK_MAX_ROUND_EXPOSURE=10000000
