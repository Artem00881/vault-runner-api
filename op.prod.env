# 1Password secret references for the PRODUCTION stack.
#
# These are NOT secrets — they are pointers into the 1Password vault
# "VaultRun-Prod". `op run` (see op-compose.sh) resolves them to real values at
# deploy time and injects them into the docker compose process environment, so
# nothing secret is written to disk. Safe to commit.
#
# Requires a 1Password service-account token at /etc/vaultrun/op-sa-token (chmod
# 600) with READ access to the VaultRun-Prod vault. See DEPLOY.md §12.
POSTGRES_PASSWORD=op://VaultRun-Prod/POSTGRES_PASSWORD/password
JWT_SECRET=op://VaultRun-Prod/JWT_SECRET/password
SENTRY_DSN=op://VaultRun-Prod/SENTRY_DSN/password
# H5: bearer for /metrics (MetricsAuthGuard). Same value lives in the host file
# /etc/vaultrun/metrics-token that Prometheus reads to scrape (DEPLOY.md §10).
METRICS_TOKEN=op://VaultRun-Prod/METRICS_TOKEN/password
# Phase 3.5 (OPTIONAL): pepper for operator-reporting API keys. Unset → sha256 hash
# (safe for 256-bit keys); set → hmac-sha256 (DB-leak defense). To enable: create the
# 1Password item, UNCOMMENT below, and mint reporting keys with the SAME pepper (run
# the provisioning CLI via op run). See DEPLOY.md §12.
# REPORTING_KEY_PEPPER=op://VaultRun-Prod/REPORTING_KEY_PEPPER/password

# Non-secret prod config (op run passes plain lines through too). Prod runs the
# grind-proof Ethereum block-hash salt; the demo's next-epoch salt is anchored to
# a real future Ethereum block (with a random fallback so the game never stalls).
SALT_PROVIDER_TYPE=eth-block
