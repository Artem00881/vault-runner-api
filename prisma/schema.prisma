// Vault Run — Stage 2 database schema
// See docs/stage2-architecture.md (in the web repo) for the full design.
// Money is stored as BIGINT in minor units (no floats). Multipliers are Decimal(10,2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A B2B operator (casino / aggregator) that embeds the game. Multi-tenant:
// each operator has its own launch secret, currencies, limits and wallet API.
// (Phase 0.3 — money pivot. The live demo runs without any operator row.)
model Operator {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique // short slug, e.g. "demo-operator"
  name                String
  enabled             Boolean  @default(true)
  demoEnabled         Boolean  @default(false) @map("demo_enabled") // may this operator launch play-money "fun mode"? compliance-conservative: off until explicitly provisioned
  launchSecret        String   @map("launch_secret") // per-operator HMAC secret for launch tokens
  currencies          String[] @default([]) // ISO/crypto codes this operator offers
  walletApiUrl        String?  @map("wallet_api_url") // operator seamless-wallet endpoint
  walletApiKey        String?  @map("wallet_api_key") // key WE use to call THEM
  callbackUrl         String?  @map("callback_url") // return-to-lobby URL
  ipWhitelist         String[] @default([]) @map("ip_whitelist")
  betLimits           Json?    @map("bet_limits") // per-currency bet-level tables
  rgConfig            Json?    @map("rg_config") // responsible-gambling config (reality checks + session limits)
  reportingApiKeyHash String?  @map("reporting_api_key_hash") // HASHED inbound API key for the operator REPORTING surface (Phase 3.5); null = no reporting access. Only ever VERIFIED, never used to sign — so it is hashed at rest (unlike launchSecret/walletApiKey).
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions GameSession[]

  @@map("operators")
}

// One game launch = one player session resolved from a signed launch token.
// Binds an operator-side player+currency to a local wallet (the per-operator
// reconciliation journal anchor) and records the token jti for one-time use.
model GameSession {
  id         String    @id @default(uuid()) @db.Uuid
  operatorId String    @map("operator_id") @db.Uuid
  playerId   String    @map("player_id") // operator-side player id
  currency   String
  locale     String    @default("en")
  walletId   String    @map("wallet_id") @db.Uuid // local journal wallet
  demo       Boolean   @default(false) // play-money "fun mode" session: money routes to the internal ledger, NEVER the operator wallet (Phase 3)
  launchJti  String    @unique @map("launch_jti") // token id → one-time use
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @updatedAt @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6) // set to revoke a live session (L-C2.2 trigger); soft so the operator-wallet resolver still serves in-flight settlement

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, playerId])
  @@index([walletId]) // walletId → session lookup (resolver() + isDemoWallet(), money-path hot)
  @@map("game_sessions")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  isGuest      Boolean   @default(true) @map("is_guest")
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(6) // F-017: PII scrubbed in place; ledger/bets retained. null = not anonymized.
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  wallets Wallet[]
  bets    Bet[]
  profile Profile?

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  currency  String   @default("DEMO")
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict) // F-017: a wallet anchors money records — never cascade-delete
  transactions LedgerTransaction[]
  bets         Bet[]

  @@unique([userId, currency])
  @@map("wallets")
}

model LedgerTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  walletId       String   @map("wallet_id") @db.Uuid
  type           String // deposit | withdrawal | bet_debit | payout_credit | refund | adjustment
  amount         BigInt // signed; debit negative
  balanceAfter   BigInt   @map("balance_after")
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict) // F-017: the money journal is retained — never cascade-delete

  @@index([walletId, createdAt(sort: Desc)])
  @@map("ledger_transactions")
}

// One provably-fair "epoch": a seed chain with its own public commit + salt.
// Epochs let the engine roll over to a fresh chain seamlessly (no exhaustion
// stall) and let the salt source vary per epoch (random today; a blockchain
// block-hash later — grind-proof).
model FairnessChain {
  id          String    @id @default(uuid()) @db.Uuid
  epoch       Int       @unique
  commitHash  String    @map("commit_hash") // seed[0] of this epoch (public commit)
  length      Int
  saltSource  String    @default("random") @map("salt_source") // "random" | "eth-block"
  targetChain String?   @map("target_chain") // e.g. "ethereum" (block-hash salt)
  targetBlock BigInt?   @map("target_block") // committed future block number
  salt        String? // known at once (random) or after finality (eth-block)
  status      String    @default("pending") // pending | armed | active | exhausted
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  armedAt     DateTime? @map("armed_at") @db.Timestamptz(6) // when the salt became known

  seeds FairnessSeed[]

  @@map("fairness_chains")
}

model FairnessSeed {
  id         String    @id @default(uuid()) @db.Uuid
  chainId    String    @map("chain_id") @db.Uuid
  chainIndex Int       @map("chain_index")
  seedHash   String    @map("seed_hash") // SHA256(seed) === previous seed (chain link)
  seed       String? // revealed only after the round it serves
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revealedAt DateTime? @map("revealed_at") @db.Timestamptz(6)

  chain  FairnessChain @relation(fields: [chainId], references: [id])
  rounds Round[]

  @@unique([chainId, chainIndex])
  @@map("fairness_seeds")
}

model Round {
  id             String    @id @default(uuid()) @db.Uuid
  seedId         String    @map("seed_id") @db.Uuid
  nonce          BigInt
  crashPoint     Decimal   @map("crash_point") @db.Decimal(10, 2) // hidden until crash
  status         String    @default("betting") // betting|running|crashed|settling|completed
  bettingOpensAt DateTime  @map("betting_opens_at") @db.Timestamptz(6)
  phaseEndsAt    DateTime? @map("phase_ends_at") @db.Timestamptz(6) // soft per-phase deadline, written by the engine (Phase 4.5b); forensics + soft-phase cold-start. NOT money/fairness-critical — the crash time is derived from startedAt+crashPoint+GROWTH.
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  crashedAt      DateTime? @map("crashed_at") @db.Timestamptz(6)
  settledAt      DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  seed FairnessSeed @relation(fields: [seedId], references: [id])
  bets Bet[]

  @@unique([seedId]) // Belt A (Phase 4.5a): a seed serves exactly one round, FOREVER — DB-enforced so two transient leaders can never double-mint a round on the same seed (the 2nd round.create hits P2002). The invariant already holds (allocateSeed filters rounds: { none: {} }); this makes it enforced not assumed.
  @@index([createdAt(sort: Desc)])
  @@index([status]) // recoverInterruptedRounds() scans the (rare) open statuses — index-served, not a seq scan (Phase 4.3)
  @@map("game_rounds")
}

model Bet {
  id           String    @id @default(uuid()) @db.Uuid
  roundId      String    @map("round_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  walletId     String    @map("wallet_id") @db.Uuid
  panel        String // A | B
  amount       BigInt
  autoCashout  Decimal?  @map("auto_cashout") @db.Decimal(10, 2)
  status       String    @default("active") // reserving|cancelling|active|cashed_out|busted|cancelled|payout_pending|voiding|voided (voiding/voided = operator void, Phase 6)
  cashoutMult  Decimal?  @map("cashout_mult") @db.Decimal(10, 2)
  payout       BigInt    @default(0)
  demo         Boolean   @default(false) // play-money bet (fun-mode session) — descriptive audit stamp; money routing is by wallet (Phase 3)
  operatorId   String?   @map("operator_id") @db.Uuid // denormalised from the session for per-operator REPORTING (Phase 3.5); null = internal/guest play (excluded from operator reports). Stamped from the verified play token; never client-supplied.
  currency     String? // denormalised journal currency (canonical UPPERCASE) for per-currency reporting (Phase 3.5)
  maxWinPerBet BigInt?   @map("max_win_per_bet") // operator per-currency single-bet win cap (Phase 3); null = global house default
  debitTxId    String?   @map("debit_tx_id") // operator tx id = arbitrary string (NOT a uuid)
  payoutTxId   String?   @map("payout_tx_id") // operator tx id = arbitrary string (NOT a uuid)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt    DateTime? @map("settled_at") @db.Timestamptz(6)

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Restrict) // F-017: bets are money records — never cascade-delete with their round
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict) // F-017: never cascade-delete a player's bet history
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict) // F-017: never cascade-delete a wallet's bet history

  @@unique([roundId, userId, panel])
  @@index([userId, createdAt(sort: Desc)])
  @@index([walletId, createdAt]) // per-session RG accounting: sum a wallet's bets since session start (Phase 3)
  @@index([operatorId, currency, createdAt]) // per-operator reporting: scope by operator + currency over a date range (Phase 3.5)
  @@index([status]) // reserving/cancelling sweep + payout_pending reconcile + backlog gauges scan the (rare) transient statuses — index-served (Phase 4.3). A partial index on just the transient set would be leaner at very large scale (revisit with partitioning, Phase 4.7).
  @@map("game_bets")
}

// Belt B (Phase 4.5a): the single-row engine leadership FENCE. Postgres holds the
// authoritative leadership token via a session advisory lock (see ElectionService);
// this table carries the monotonic fencing token a stale leader checks before any
// engine-authored write. `id` is a singleton boolean (always true) so there is
// exactly one row; the migration seeds it so an UPDATE always has a row to bump.
// Wired to the engine in Phase 4.5b — additive/dormant in 4.5a.
model EngineLeadership {
  id         Boolean   @id @default(true) // singleton: only ever one row (id = true)
  fence      BigInt    @default(0) // monotonic; bumped on every leadership acquire
  nodeId     String?   @map("node_id") // who currently believes it is the leader
  acquiredAt DateTime? @map("acquired_at") @db.Timestamptz(6)

  @@map("engine_leadership")
}

model Profile {
  userId            String   @id @map("user_id") @db.Uuid
  displayName       String   @map("display_name")
  biggestMultiplier Decimal  @default(1.00) @map("biggest_multiplier") @db.Decimal(10, 2)
  totalLoot         BigInt   @default(0) @map("total_loot")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict) // F-017: anonymize the profile in place (displayName scrub) rather than cascade-delete

  @@index([biggestMultiplier(sort: Desc), totalLoot(sort: Desc)])
  @@map("profiles")
}

// Unified significant-event AUDIT LOG (audit F-058). An APPEND-ONLY, standalone
// record of operator / config / key / void / session-revoke / RNG events — the
// "who did what, when" trail GLI-19 expects alongside the money ledger + seed chain.
// DELIBERATELY has NO relation/FK (the ids are denormalised, the way Bet carries a
// bare operatorId): nothing can CASCADE a row away, and the table stands on its own.
// The app only ever INSERTs here (AuditEventService exposes no update/delete); prod
// REVOKEs UPDATE/DELETE from the app DB role to make immutability enforced, not assumed.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      String // who: "operator:<id>" | "system" | "provision-cli" | "engine" | "reconciler"
  action     String // dotted verb, e.g. "operator.bet_void" | "operator.provision" | "reporting_key.rotate" | "session.revoke" | "rng.epoch_commit" | "rng.salt_fallback"
  targetType String?  @map("target_type") // "bet" | "operator" | "game_session" | "rng_epoch" | ...
  targetId   String?  @map("target_id") // free-form id of the affected entity (NOT a typed FK)
  operatorId String?  @map("operator_id") @db.Uuid // denormalised for per-operator queries — NO relation/FK (keep the log standalone + append-only). UUID to match game_bets/game_sessions.operator_id (a real operator id IS a uuid); actor/targetType/targetId stay TEXT (genuinely free-form).
  ip         String? // caller IP when the event was operator-initiated over HTTP
  before     Json? // entity state / changed fields before the action (NEVER a secret value)
  after      Json? // entity state / changed fields after the action (NEVER a secret value)
  meta       Json? // extra context (reason, counts, hash-prefix, …)

  @@index([createdAt])
  @@index([operatorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

/// Operator-wallet rollback ledger (audit M1 — F-002 once-only marker + F-027 durable
/// outbox). ONE row per (operatorId, transactionId) we ever need to roll back at the
/// operator (ambiguous/transient debit compensation, and the void reclaim/refund legs).
///
/// Two jobs in one table:
///  - F-002 (once-only): the @@unique([operatorId, transactionId]) makes a rollback emit
///    idempotent ON OUR SIDE — a `confirmed` row means "already rolled back, do NOT re-emit"
///    so a void resume / retry can't double-reverse even against a non-idempotent operator.
///  - F-027 (durable discrepancy): a row left `pending` (the operator rollback call failed)
///    is the persisted owed-rollback the periodic drain (game.gateway sweep) re-emits until
///    it confirms — the discrepancy is never lost.
///
/// NO foreign key BY DESIGN (mirrors AuditEvent): the ids are denormalised so nothing can
/// CASCADE a row away. NOT append-only / NO immutability trigger (unlike audit_events): a
/// row legitimately transitions pending → confirmed (status/attempts/lastError/resolvedAt
/// are updated), so the table is mutable; the test/soak teardown scoped-deletes its own rows.
model WalletRollback {
  id            String    @id @default(uuid()) @db.Uuid
  operatorId    String    @map("operator_id") @db.Uuid
  playerId      String    @map("player_id")
  currency      String
  // The ORIGINAL operator transaction being reversed (the operator dedups on this). REUSABLE
  // (a debit key is reused by a re-bet) → NOT the once-only key; the drain re-emits with it.
  transactionId String    @map("transaction_id")
  // The LOGICAL-reversal once-only identity = `{betId|transactionId}#{reason}`. Intent-and-
  // bet-distinct so cross-intent / same-reason-different-bet reversals never conflate (M1).
  dedupeKey     String    @map("dedupe_key")
  reason        String // ambiguous_debit | transient_debit | void_reclaim | void_refund
  betId         String?   @map("bet_id") @db.Uuid
  amount        BigInt? // original move magnitude (minor units); informational for the drain/recon
  status        String    @default("pending") // pending | draining | confirmed
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  // #2: while `draining`, the owning drain holds the row until this instant; a stale lease
  // (crashed drain) is reclaimable by the next pass. NULL when not draining.
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@unique([operatorId, dedupeKey])
  @@index([status, createdAt])
  @@map("wallet_rollbacks")
}
