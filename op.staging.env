# 1Password secret references for the STAGING stack.
#
# Same idea as op.prod.env, but pointing at the "VaultRun-Staging" vault (staging
# has its OWN secrets, never shared with prod). These are NOT secrets — only
# op:// references. Resolved at deploy time by `op run` (see op-compose.staging.sh).
# Requires a service-account token at /etc/vaultrun/op-sa-token (chmod 600) with
# READ access to the VaultRun-Staging vault.
#
# Staging runs without Sentry, so SENTRY_DSN is intentionally omitted.
POSTGRES_PASSWORD=op://VaultRun-Staging/POSTGRES_PASSWORD/password
JWT_SECRET=op://VaultRun-Staging/JWT_SECRET/password
